                    <use height="1448" href="#kk-crane" width="1426"></use>
                </svg>
                <span aria-hidden="true"
                    class="h-[clamp(44px,min(7vw,10vh),92px)] w-[1.5px] flex-none bg-current"></span>
                <svg aria-hidden="true" class="h-[clamp(28px,min(4.6vw,6.8vh),62px)] w-auto flex-none"
                    viewBox="0 0 1302 921">
                    <use height="921" href="#kk-monogram" width="1302"></use>
                </svg>
                <span class="flex flex-col items-start">
                    <span
