<.site_symbols />
<.masthead />
<.site_header />
<section class="relative overflow-hidden bg-linear-to-b/srgb from-[#f8f5ef] via-sky via-60% to-[#e7ecef] pt-[clamp(1.5rem,4.5svh,5rem)] pb-[clamp(90px,calc(18svh_-_10px),200px)] max-sm:pt-[1.4rem]">
  <div
    aria-hidden="true"
    class="hero-orb pointer-events-none absolute -top-[22vh] -right-[14vw] size-[62vw] max-h-[780px] max-w-[780px] rounded-full max-md:-top-[55vw] max-md:-right-[50vw] max-md:size-[110vw]"
  >
  </div>
  <div class="wrap relative z-[2]">
    <div>
      <p class="mb-[.6rem] font-display text-[clamp(1.1rem,1.8vw,1.35rem)] text-brass-deep italic">
        Kancelaria
        adwokacka w Gdańsku
      </p>
      <h1 class="text-[clamp(2.1rem,min(5.6vw,7svh),4.6rem)]">
        Pomoc prawna, która<br />
        <em class="text-[.85em] whitespace-nowrap text-brass-text italic max-[700px]:whitespace-normal max-md:text-[.7em]">
          skutecznie
          rozwiązuje Twoje problemy
        </em>
      </h1>
      <p class="mt-[clamp(.8rem,2.2svh,1.5rem)] mb-[clamp(1.1rem,3svh,2.25rem)] text-[1.15rem] text-muted max-sm:text-[1.02rem]">
        Zapewniamy wsparcie prawne osobom prywatnym i przedsiębiorcom — od pojedynczych spraw po
        stałą obsługę firm i spory masowe.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          class="btn btn-ghost max-sm:w-full max-sm:text-center plausible-event-name=Telefon plausible-event-miejsce=Hero"
          href="tel:+48698359581"
        >
          Zadzwoń:
          698 359 581
        </a>
        <a
          class="btn btn-ghost max-sm:w-full max-sm:text-center plausible-event-name=Telefon plausible-event-miejsce=Hero"
          href="tel:+48793102489"
        >
          Zadzwoń:
          793 102 489
        </a>
      </div>
    </div>
  </div>
