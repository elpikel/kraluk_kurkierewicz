            <form class="form-glass grid gap-4 rounded-[14px] border border-white/14 p-[clamp(1.25rem,3vw,2rem)]"
                id="contact-form">
                <label class="grid gap-[.35rem] text-[.9rem] text-white/85">Imię i nazwisko <input
                        class="rounded-lg border border-white/20 bg-[rgba(10,25,45,.22)] px-4 py-[.8rem] text-cream shadow-[inset_0_1px_2px_rgba(0,0,0,.18)] transition-[border-color,box-shadow] duration-200 focus:border-brass focus:shadow-[inset_0_1px_2px_rgba(0,0,0,.18),0_0_0_3px_rgba(207,174,126,.28)] focus:outline-none"
                        name="name" required type="text"></label>
                <label class="grid gap-[.35rem] text-[.9rem] text-white/85">E-mail lub telefon <input
                        class="rounded-lg border border-white/20 bg-[rgba(10,25,45,.22)] px-4 py-[.8rem] text-cream shadow-[inset_0_1px_2px_rgba(0,0,0,.18)] transition-[border-color,box-shadow] duration-200 focus:border-brass focus:shadow-[inset_0_1px_2px_rgba(0,0,0,.18),0_0_0_3px_rgba(207,174,126,.28)] focus:outline-none"
                        name="contact" required type="text"></label>
                <label class="grid gap-[.35rem] text-[.9rem] text-white/85">Czego dotyczy sprawa <textarea
                        class="rounded-lg border border-white/20 bg-[rgba(10,25,45,.22)] px-4 py-[.8rem] text-cream shadow-[inset_0_1px_2px_rgba(0,0,0,.18)] transition-[border-color,box-shadow] duration-200 focus:border-brass focus:shadow-[inset_0_1px_2px_rgba(0,0,0,.18),0_0_0_3px_rgba(207,174,126,.28)] focus:outline-none min-h-[130px] resize-y"
                        name="message" required></textarea></label>
                <button class="btn justify-self-start max-sm:w-full" type="submit">Wyślij
                    wiadomość</button>
                <p class="text-[.9rem] font-semibold text-brass-soft" hidden id="form-status" role="status"></p>
                <p class="text-[.8rem] text-white/60 [&_a]:text-white/85 [&_a]:underline [&_a]:underline-offset-2">
                    Administratorem danych podanych w formularzu jest Kraluk Kurkierewicz Adwokacka Spółka
                    Partnerska z siedzibą w Gdańsku. Dane przetwarzamy w celu odpowiedzi na zapytanie i
                    ewentualnego podjęcia współpracy (art. 6 ust. 1 lit. b i f RODO). Informacje o
                    Twoich prawach znajdziesz w <a href="#">Polityce prywatności</a>.</p>
            </form>
        </div>
    </section>
