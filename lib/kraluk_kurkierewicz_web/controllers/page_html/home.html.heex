                        Kurkierewicz</span>
                    <span
                        class="mt-[clamp(.3rem,.8vw,.55rem)] text-[clamp(.45rem,.95vw,.8rem)] font-medium tracking-[.3em] whitespace-nowrap uppercase max-sm:tracking-[.16em] max-xs:text-[.42rem]">Adwokacka
                        Spółka Partnerska</span>
                </span>
            </a>
            <p
                class="mt-[clamp(.5rem,1.4vh,1.15rem)] max-w-none text-center text-[clamp(.58rem,1vw,.8rem)] font-medium tracking-[.5em] text-brass-deep uppercase max-xs:tracking-[.3em]">
                Prawo <span aria-hidden="true" class="mx-[.9em] max-xs:mx-[.5em]">/</span> Ludzie <span
                    aria-hidden="true" class="mx-[.9em] max-xs:mx-[.5em]">/</span> Gdańsk</p>
        </div>
    </div>
    <header
        class="group sticky top-[env(safe-area-inset-top,0px)] z-10 border-b border-line-soft bg-white/88 shadow-[0_10px_30px_-24px_rgba(47,71,102,.45)] backdrop-blur-[10px] backdrop-saturate-[1.4]"
        id="header">
        <div class="wrap flex h-16 items-center justify-between gap-6 max-sm:h-[54px]">
