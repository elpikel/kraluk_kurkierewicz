<%!-- Shared hero with the team photo and KK monogram, used by service pages and the price list.
     Assigns: @title ("Headline — accent"), @lead, @current (last breadcrumb), @crumbs
     ([{label, path}] between "Strona główna" and @current), @place (Plausible "miejsce"). --%>
<section class="relative overflow-hidden bg-[#1c2a3d] lg:grid lg:min-h-[clamp(460px,62svh,620px)] lg:grid-cols-2 lg:bg-[#cdc9c0]">
  <%!-- Same as the home hero: full-bleed photo behind the text on phones, right column on desktop --%>
  <div class="absolute inset-0 lg:relative lg:col-start-2 lg:row-start-1">
    <picture>
      <source
        media="(max-width: 959px)"
        srcset={"#{~p"/images/hero-zespol-m-640.webp"} 640w, #{~p"/images/hero-zespol-m-960.webp"} 960w"}
        sizes="100vw"
        width="960"
        height="1086"
      />
      <img
        src={~p"/images/hero-zespol-900.webp"}
        srcset={"#{~p"/images/hero-zespol-560.webp"} 560w, #{~p"/images/hero-zespol-900.webp"} 900w, #{~p"/images/hero-zespol-1400.webp"} 1400w"}
        sizes="50vw"
        alt="Adwokaci Milena Kraluk i Michał Kurkierewicz"
        width="1400"
        height="1768"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top lg:object-[50%_28%]"
      />
    </picture>
    <%!-- Monogram half on the photo: the mask is opaque on the wall and transparent on the people;
         mask-size/position mirror the photo's object-cover and object-position. --%>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 z-[1] hidden overflow-hidden lg:block"
      style={"-webkit-mask: url(#{~p"/images/hero-zespol-tlo-maska.webp"}) 50% 28% / cover no-repeat; mask: url(#{~p"/images/hero-zespol-tlo-maska.webp"}) 50% 28% / cover no-repeat;"}
    >
      <svg
        class="absolute top-1/2 left-[calc(max(0px,(100vw_-_1140px)/2)_+_clamp(20px,5vw,56px)_-_50vw)] h-[86%] w-auto -translate-x-[17.8%] -translate-y-1/2 text-ink opacity-[.05]"
        viewBox="0 0 1302 921"
      >
        <use height="921" href="#kk-monogram" width="1302"></use>
      </svg>
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-[#141e2c]/92 via-[#141e2c]/60 via-55% to-[#141e2c]/0 lg:hidden"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-0 hidden w-[14%] bg-linear-to-r/srgb from-[#c9c5bb] via-[#c9c5bb]/60 via-40% to-transparent lg:block"
    >
    </div>
  </div>
  <%!-- Desktop: the KK monogram spans both columns but is drawn as two halves so the photo stays
       untouched. This half sits on the text column's gradient; the other half is inside the photo
       column, masked so it shows only on the wall and disappears behind the figures. Both halves
       use the same size and position, expressed relative to their own column. --%>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-0 z-0 hidden w-1/2 overflow-hidden bg-linear-to-r/srgb from-[#e4e0d9] via-[#dbd7ce] via-65% to-[#c9c5bb] lg:block"
  >
    <svg
      class="absolute top-1/2 left-[calc(max(0px,(100vw_-_1140px)/2)_+_clamp(20px,5vw,56px))] h-[86%] w-auto -translate-x-[17.8%] -translate-y-1/2 text-ink opacity-[.05]"
      viewBox="0 0 1302 921"
    >
      <use height="921" href="#kk-monogram" width="1302"></use>
    </svg>
  </div>
  <div class="relative z-[2] flex flex-col pt-[60vw] pr-[clamp(20px,5vw,56px)] pb-8 pl-[calc(max(0px,(100vw_-_1140px)/2)_+_clamp(20px,5vw,56px))] sm:pt-[52vw] md:pt-[44vw] lg:col-start-1 lg:row-start-1 lg:justify-center lg:py-[clamp(2.5rem,7svh,4.5rem)] lg:pr-[clamp(32px,4vw,64px)]">
    <div class="relative z-[2]">
      <nav
        aria-label="Ścieżka"
        class="mb-5 text-[.85rem] text-white/75 lg:mb-6 lg:text-[.88rem] lg:text-[#474e58] [&_a:hover]:text-white lg:[&_a:hover]:text-ink"
      >
        <a href={~p"/"}>Strona główna</a>
        <span aria-hidden="true" class="mx-2 text-brass lg:text-brass-deep">/</span>
        <%= for {label, path} <- @crumbs do %>
          <a href={path}>{label}</a>
          <span aria-hidden="true" class="mx-2 text-brass lg:text-brass-deep">/</span>
        <% end %>
        <span aria-current="page" class="text-white lg:text-ink">{@current}</span>
      </nav>
      <%!-- Two-tone headline like the home hero: the part after "—" is the italic accent --%>
      <% [headline | accent] = String.split(@title, " — ", parts: 2) %>
      <h1 class="max-w-[22ch] text-[clamp(1.85rem,7vw,3rem)] text-white max-lg:leading-[1.12] lg:text-[clamp(2rem,min(3.2vw,6svh),3rem)] lg:text-ink">
        {headline}
        <%= if accent != [] do %>
          <br />
          <em class="text-[#e6cb98] italic lg:text-[#84633a]">{hd(accent)}</em>
        <% end %>
      </h1>
      <p class="mt-4 mb-8 max-w-[34rem] text-[1.08rem] text-white/80 max-sm:text-[.95rem] lg:mt-5 lg:mb-11 lg:text-[1.12rem] lg:text-[#474e58]">
        {@lead}
      </p>
      <div class="flex flex-wrap gap-4 max-sm:gap-3 lg:flex-nowrap lg:gap-3">
        <a
          class={"btn whitespace-nowrap max-sm:w-full max-sm:text-center lg:px-4 plausible-event-name=Telefon plausible-event-miejsce=#{@place}"}
          href="tel:+48698359581"
        >
          Zadzwoń: 698 359 581
        </a>
        <a
          class={"btn btn-ghost whitespace-nowrap max-sm:w-full max-sm:text-center lg:px-4 max-lg:border-white/60 max-lg:bg-white/10 max-lg:text-white max-lg:backdrop-blur-sm max-lg:hover:bg-white/20 max-lg:hover:text-white plausible-event-name=Telefon plausible-event-miejsce=#{@place}"}
          href="tel:+48793102489"
        >
          Zadzwoń: 793 102 489
        </a>
      </div>
    </div>
  </div>
</section>
