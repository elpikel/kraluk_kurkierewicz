<.site_symbols />
<.site_header active_nav={assigns[:active_nav]} />
<section class="border-b border-line-soft bg-linear-to-b/srgb from-paper to-[#f3f0e9] py-[clamp(2.5rem,6vw,4.5rem)]">
  <div class="wrap">
    <nav aria-label="Ścieżka" class="mb-6 text-[.88rem] text-muted [&_a:hover]:text-ink">
      <a href={~p"/"}>Strona główna</a>
      <span aria-hidden="true" class="mx-2 text-brass-deep">/</span>
      <span aria-current="page" class="text-ink">Cennik</span>
    </nav>
    <h1 class="text-[clamp(2.1rem,4.6vw,3.2rem)]">
      Cennik usług<br />
      <em class="text-[#84633a] italic">kancelaria adwokacka w Gdańsku</em>
    </h1>
    <p class="mt-5 max-w-[62ch] text-[1.12rem] text-muted">
      Poniżej podajemy orientacyjne przedziały cenowe. Przed rozpoczęciem współpracy zawsze
      przedstawiamy indywidualną wycenę — tak, abyś od początku wiedział, ile będzie kosztować
      prowadzenie sprawy.
    </p>
  </div>
</section>

<section class="bg-cream py-section max-sm:py-12">
  <div class="wrap grid gap-12">
    <div :for={{title, items} <- @sections}>
      <h2>{title}</h2>
      <div class="overflow-hidden rounded-[14px] border border-line-soft bg-paper shadow-card">
        <table class="w-full border-collapse text-left">
          <thead class="sr-only">
            <tr>
              <th scope="col">Usługa</th>
              <th scope="col">Cena (z VAT)</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={{label, min, max, service} <- items}
              class="border-b border-line last:border-b-0 max-sm:flex max-sm:flex-col max-sm:gap-1 max-sm:py-4"
            >
              <th
                scope="row"
                class="px-6 py-4 text-[1rem] font-normal text-copy max-sm:px-5 max-sm:py-0"
              >
                {label}
                <a
                  :if={service}
                  class="mt-[.15rem] block text-[.82rem] font-semibold text-brass-deep transition-colors hover:text-ink"
                  href={~p"/uslugi/#{service.slug}"}
                >
                  {service.name} →
                </a>
              </th>
              <td class="px-6 py-4 text-right font-display text-[1.25rem] font-semibold whitespace-nowrap text-ink max-sm:px-5 max-sm:py-0 max-sm:text-left">
                {KralukKurkierewicz.Pricing.format_range(min, max)}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="rounded-[10px] border border-line-soft bg-paper px-[1.35rem] py-[1.1rem] text-[.92rem] text-muted">
      <p class="m-0"><strong>Ważne informacje</strong></p>
      <ul class="mt-2 list-disc pl-5 [&_li+li]:mt-1">
        <li :for={note <- @notes}>{note}</li>
      </ul>
    </div>
  </div>
</section>

<section class="bg-cream pb-section max-sm:pb-12">
  <div class="wrap">
    <.post_end_cta place="Cennik-koniec" />
  </div>
</section>
<.site_footer />
