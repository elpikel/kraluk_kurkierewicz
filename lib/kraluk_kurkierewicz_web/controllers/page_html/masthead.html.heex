<div
  class="border-b border-line bg-paper pt-[clamp(1rem,2.4vh,2rem)] pb-[clamp(.8rem,2vh,1.5rem)]"
  id="masthead"
>
  <div class="wrap flex flex-col items-center">
    <a
      aria-label="Kraluk Kurkierewicz Adwokacka Spółka Partnerska – strona główna"
      class="flex items-center gap-[clamp(.9rem,2.2vw,1.6rem)] text-ink-deep max-xs:gap-[.6rem]"
      href={~p"/"}
    >
      <svg
        aria-hidden="true"
        class="h-[clamp(46px,min(7vw,10vh),92px)] w-auto flex-none"
        viewBox="0 0 1426 1448"
      >
        <use height="1448" href="#kk-crane" width="1426"></use>
      </svg>
      <span
        aria-hidden="true"
        class="h-[clamp(44px,min(7vw,10vh),92px)] w-[1.5px] flex-none bg-current"
      >
      </span>
      <svg
        aria-hidden="true"
        class="h-[clamp(28px,min(4.6vw,6.8vh),62px)] w-auto flex-none"
        viewBox="0 0 1302 921"
      >
        <use height="921" href="#kk-monogram" width="1302"></use>
      </svg>
      <span class="flex flex-col items-start">
        <span class="font-display text-[clamp(.9rem,min(2.9vw,4.2vh),2.3rem)] leading-[1.02] font-semibold tracking-[.06em] whitespace-nowrap uppercase max-xs:tracking-[.05em]">
          Kraluk
          Kurkierewicz
        </span>
        <span class="mt-[clamp(.3rem,.8vw,.55rem)] text-[clamp(.45rem,.95vw,.8rem)] font-medium tracking-[.3em] whitespace-nowrap uppercase max-sm:tracking-[.16em] max-xs:text-[.42rem]">
          Adwokacka
          Spółka Partnerska
        </span>
      </span>
    </a>
    <p class="mt-[clamp(.5rem,1.4vh,1.15rem)] max-w-none text-center text-[clamp(.58rem,1vw,.8rem)] font-medium tracking-[.5em] text-brass-deep uppercase max-xs:tracking-[.3em]">
      Prawo <span aria-hidden="true" class="mx-[.9em] max-xs:mx-[.5em]">/</span>
      Ludzie <span aria-hidden="true" class="mx-[.9em] max-xs:mx-[.5em]">/</span>
      Gdańsk
    </p>
  </div>
</div>
