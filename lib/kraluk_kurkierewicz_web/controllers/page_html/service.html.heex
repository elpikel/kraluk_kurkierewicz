<.site_symbols />
<.site_header active_nav={assigns[:active_nav]} />
<.photo_hero
  title={@service.title}
  lead={@service.lead}
  current={@service.name}
  crumbs={[{"Specjalizacje", ~p"/#specjalizacje"}]}
  place="Usluga"
/>

<section class="bg-cream py-section max-sm:py-12">
  <div class="wrap grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-16">
    <div class="[&_p]:text-[1.05rem] [&_p]:leading-[1.75] [&_p+p]:mt-4">
      <div
        class="mb-8 border-l-[3px] border-brass py-1 pl-[clamp(1.1rem,3vw,1.5rem)]"
        id="w-skrocie"
      >
        <h2 class="m-0 font-sans text-[.8rem] font-semibold tracking-[.14em] text-brass-deep uppercase">
          W skrócie
        </h2>
        <ul class="mt-3 grid gap-2 pl-5 marker:text-brass [&>li]:list-disc [&>li]:text-[1rem] [&>li]:leading-[1.6] [&>li]:text-ink">
          <li :for={point <- @summary}>{point}</li>
        </ul>
        <p
          class="mt-4! text-[.86rem]! text-muted"
          id="service-updated"
        >
          Zaktualizowano:
          <time datetime={Date.to_iso8601(@updated)}>{format_date_pl(@updated)}</time>
          <span :if={@leads != []}>
            · Weryfikacja merytoryczna:
            <%= for {lead, i} <- Enum.with_index(@leads) do %>
              {if i > 0, do: "i"}
              <a
                class="font-semibold text-ink transition-colors hover:text-brass-deep"
                href={~p"/zespol/#{lead.slug}"}
              >
                {lead.display_name}
              </a>
            <% end %>
          </span>
        </p>
      </div>

      <p :for={paragraph <- @service.intro}>{linked(paragraph)}</p>

      <h2 class="mt-12">W czym pomagamy</h2>
      <ul class="mt-2 border-t border-line">
        <li
          :for={{title, text} <- @service.scope}
          class="relative border-b border-line py-5 pl-[1.4rem] before:absolute before:top-[1.85rem] before:left-0 before:size-[7px] before:rounded-full before:bg-brass before:shadow-[0_0_0_3px_rgba(207,174,126,.18)]"
        >
          <h3 class="mb-1 font-sans text-[1.05rem] font-semibold text-ink">{title}</h3>
          <p class="m-0 text-[.98rem]! text-muted">{text}</p>
        </li>
      </ul>

      <%!-- In-text upsell for phones and tablets only: on desktop the sticky contact
           card in the sidebar does this job. --%>
      <div class="lg:hidden" id="service-cta-1">
        <.post_cta title="Masz podobną sprawę?" place="Usluga-srodek">
          Opowiedz nam o niej. Ocenimy Twoją sytuację i przed podjęciem działań przedstawimy
          rekomendację, przewidywany czas oraz koszty.
        </.post_cta>
      </div>

      <%= for {{title, blocks}, i} <- Enum.with_index((@details && @details.sections) || []) do %>
        <.service_section title={title} blocks={blocks} />
        <div :if={i == 3 and length(@details.sections) > 5} class="lg:hidden" id="service-cta-2">
          <.post_cta title="Wolisz omówić to z adwokatem?" place="Usluga-sekcje">
            Każda sprawa ma swoje szczegóły, których nie rozstrzygnie ogólny opis. Konsultację
            prowadzimy w kancelarii w Gdańsku, telefonicznie lub przez wideo.
          </.post_cta>
        </div>
      <% end %>

      <div id="w-gdansku">
        <h2 class="mt-12">W Gdańsku i Trójmieście</h2>
        <p>{linked(KralukKurkierewicz.Services.local(@service))}</p>
      </div>

      <div :if={@details} id="dokumenty">
        <h2 class="mt-12">Jakie dokumenty przygotować?</h2>
        <ul class="mt-2 grid gap-2 sm:grid-cols-2">
          <li
            :for={document <- @details.documents}
            class="flex items-start gap-3 py-1 text-[.96rem] leading-snug text-copy"
          >
            <.icon name="hero-document-text" class="mt-[.1rem] size-5 flex-none text-brass-deep" />
            {document}
          </li>
        </ul>
      </div>

      <h2 class="mt-12">Najczęstsze pytania</h2>
      <div class="border-t border-line" id="faq">
        <%!-- Same entries feed this page's FAQPage JSON-LD (Services.faq/1) --%>
        <details
          :for={{{question, answer}, i} <- Enum.with_index(@faq)}
          id={"faq-#{i}"}
          class="group border-b border-line"
          open={i == 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-display text-[1.3rem] leading-snug font-semibold text-ink transition-colors hover:text-brass-deep [&::-webkit-details-marker]:hidden">
            {question}
            <.icon
              name="hero-chevron-down"
              class="size-5 flex-none text-brass-deep transition-transform duration-300 group-open:rotate-180 motion-reduce:transition-none"
            />
          </summary>
          <p class="mt-0! pr-12 pb-5 text-muted max-sm:pr-0">{answer}</p>
        </details>
      </div>

      <div class="mt-10 border-l-[3px] border-brass py-1 pl-[1.35rem] text-[.92rem] text-muted">
        <p class="m-0 text-[.92rem]!"><strong>Podstawa prawna</strong></p>
        <ul class="mt-2 list-disc pl-5 [&_a]:border-b [&_a]:border-brass [&_a]:text-ink [&_a:hover]:border-ink">
          <li :for={{name, url} <- KralukKurkierewicz.Services.acts(@service)} class="mt-1">
            <a href={url} rel="noopener" target="_blank">{name}</a>
          </li>
        </ul>
      </div>
    </div>

    <aside class="flex flex-col gap-6">
      <div
        :if={@leads != []}
        class="rounded-[14px] border border-line-soft bg-cream p-5 shadow-card"
        id="service-lead"
      >
        <p class="m-0 text-[.8rem] font-semibold tracking-[.12em] text-brass-deep uppercase">
          {if length(@leads) > 1, do: "Sprawy prowadzą", else: "Sprawy prowadzi"}
        </p>
        <ul class="mt-1">
          <li :for={lead <- @leads}>
            <a
              class="group grid grid-cols-[64px_1fr] items-center gap-4 py-3"
              href={~p"/zespol/#{lead.slug}"}
              id={"service-lead-#{lead.slug}"}
            >
              <img
                src={lead.image}
                alt={"#{lead.display_name} — zdjęcie"}
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
                class="aspect-square w-full rounded-full object-cover object-[50%_20%] ring-1 ring-line transition-transform duration-200 group-hover:scale-[1.04] motion-reduce:transition-none"
              />
              <span>
                <span class="block font-display text-[1.3rem] leading-snug font-semibold text-ink transition-colors group-hover:text-brass-deep">
                  {lead.display_name}
                </span>
                <span class="block text-[.86rem] text-muted">{lead.role}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>

      <div class="rounded-[14px] border border-line-soft bg-paper p-6 shadow-card">
        <p class="m-0 text-[.8rem] font-semibold tracking-[.12em] text-brass-deep uppercase">
          Jak pracujemy
        </p>
        <ol class="mt-4 grid gap-3 text-[.98rem] text-copy [counter-reset:step] *:relative *:pl-9 *:[counter-increment:step] *:before:absolute *:before:top-0 *:before:left-0 *:before:grid *:before:size-6 *:before:place-items-center *:before:rounded-full *:before:border *:before:border-brass/60 *:before:text-[.78rem] *:before:font-semibold *:before:text-brass-deep *:before:content-[counter(step)]">
          <li>Poznajemy sprawę i Twoje cele.</li>
          <li>Przedstawiamy rekomendację, przewidywany czas i koszty.</li>
          <li>Przygotowujemy pisma, negocjujemy i reprezentujemy Cię przed sądem.</li>
          <li>Doprowadzamy sprawę do końca — także do wykonania wyroku.</li>
        </ol>
      </div>

      <nav
        aria-label="Powiązane usługi"
        class="rounded-[14px] border border-line-soft bg-cream p-6"
        id="powiazane-uslugi"
      >
        <p class="m-0 text-[.8rem] font-semibold tracking-[.12em] text-brass-deep uppercase">
          Powiązane usługi
        </p>
        <ul class="mt-2">
          <li :for={related <- @related}>
            <a
              class="group flex items-baseline justify-between gap-3 py-2"
              href={~p"/uslugi/#{related.slug}"}
            >
              <span class="font-display text-[1.2rem] leading-snug font-semibold text-ink transition-colors group-hover:text-brass-deep">
                {related.name}
              </span>
              <span
                aria-hidden="true"
                class="flex-none text-brass-deep transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none"
              >
                →
              </span>
            </a>
          </li>
        </ul>
      </nav>

      <div :if={@posts != []} class="rounded-[14px] border border-line-soft bg-cream p-6">
        <p class="m-0 text-[.8rem] font-semibold tracking-[.12em] text-brass-deep uppercase">
          Z naszego bloga
        </p>
        <ul class="mt-3 grid gap-4">
          <li :for={post <- @posts}>
            <a class="group block" href={~p"/blog/#{post.slug}"}>
              <span class="block font-display text-[1.2rem] leading-snug font-semibold text-ink transition-colors group-hover:text-brass-deep">
                {post.title}
              </span>
              <span class="mt-1 block text-[.85rem] text-muted">{post.date_display}</span>
            </a>
          </li>
        </ul>
      </div>

      <%!-- Contact card: last in the sidebar and sticky, so on desktop it stays in view
           next to the long article once the cards above have scrolled away. Hidden below
           `lg`, where the sidebar stacks right above the closing CTA and would repeat it. --%>
      <div
        class="bg-contact hidden rounded-[14px] p-6 text-cream shadow-card lg:sticky lg:top-24 lg:block"
        id="service-contact"
      >
        <p class="m-0 text-[.8rem] font-semibold tracking-[.12em] text-brass uppercase">
          Porozmawiaj z adwokatem
        </p>
        <p class="mt-2 font-display text-[1.45rem] leading-snug font-semibold text-cream">
          Umów konsultację w sprawie: {@service.name}
        </p>
        <p class="mt-2 text-[.95rem] text-white/80">
          W kancelarii w Gdańsku, telefonicznie lub przez wideo. Pon.-pt. 9:00-17:00.
        </p>
        <div class="mt-4 grid gap-2">
          <a
            :for={
              {tel, phone} <- [{"+48698359581", "698 359 581"}, {"+48793102489", "793 102 489"}]
            }
            class="btn text-center plausible-event-name=Telefon plausible-event-miejsce=Usluga-bok"
            href={"tel:#{tel}"}
          >
            Zadzwoń: {phone}
          </a>
          <a
            class="btn btn-ghost border-white/50 bg-white/10 text-center text-white hover:bg-white/20 hover:text-white plausible-event-name=CTA plausible-event-cel=Umow-spotkanie plausible-event-miejsce=Usluga-bok"
            href={~p"/#kontakt"}
          >
            Napisz do nas
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>

<section class="bg-cream pb-section max-sm:pb-12">
  <div class="wrap">
    <.post_end_cta place="Usluga-koniec" />
  </div>
</section>
<.site_footer />
