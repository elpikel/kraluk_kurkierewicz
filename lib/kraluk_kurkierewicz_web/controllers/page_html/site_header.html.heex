<header
  class="sticky top-[env(safe-area-inset-top,0px)] z-10 border-b border-line-soft bg-white/88 shadow-[0_10px_30px_-24px_rgba(47,71,102,.45)] backdrop-blur-[10px] backdrop-saturate-[1.4]"
  id="header"
>
  <div class="wrap flex h-16 items-center justify-between gap-6 max-sm:h-[54px]">
    <a
      aria-label="Kraluk Kurkierewicz Adwokacka Spółka Partnerska - strona główna"
      class="flex items-center gap-3 text-ink-deep max-sm:gap-[.6rem]"
      href={~p"/"}
      id="logo"
    >
      <svg
        aria-hidden="true"
        class="h-[42px] w-auto flex-none max-sm:h-[34px]"
        viewBox="0 0 1426 1448"
      >
        <use height="1448" href="#kk-crane" width="1426"></use>
      </svg>
      <span aria-hidden="true" class="h-9 w-px flex-none bg-current opacity-70 max-sm:hidden">
      </span>
      <svg
        aria-hidden="true"
        class="h-[26px] w-auto flex-none max-sm:hidden"
        viewBox="0 0 1302 921"
      >
        <use height="921" href="#kk-monogram" width="1302"></use>
      </svg>
      <span class="flex flex-col items-start">
        <span class="font-display text-[1.2rem] leading-none font-semibold tracking-[.07em] whitespace-nowrap uppercase max-sm:text-[1rem]">
          Kraluk
          Kurkierewicz
        </span>
        <span class="mt-[.35rem] text-[.56rem] leading-none font-medium tracking-[.28em] whitespace-nowrap uppercase max-sm:text-[.5rem] max-sm:tracking-[.18em]">
          Adwokacka
          Spółka Partnerska
        </span>
      </span>
    </a>
    <nav
      class="hidden text-[.95rem] whitespace-nowrap xl:flex xl:items-center xl:gap-[clamp(1.1rem,2vw,2rem)] max-xl:data-open:absolute max-xl:data-open:inset-x-0 max-xl:data-open:top-16 max-xl:data-open:flex max-xl:data-open:flex-col max-xl:data-open:border-b max-xl:data-open:border-line-soft max-xl:data-open:bg-white max-xl:data-open:px-[clamp(20px,5vw,56px)] max-xl:data-open:pt-4 max-xl:data-open:pb-6 max-xl:data-open:shadow-[0_24px_40px_-28px_rgba(47,71,102,.45)] max-sm:data-open:top-[54px]"
      id="nav"
    >
      <%!-- Desktop: hover/focus panel with every service page; mobile menu keeps the plain link --%>
      <div class="group/spec relative max-xl:contents">
        <a
          class="border-b border-transparent py-1 hover:border-brass max-xl:border-line-soft max-xl:py-3 plausible-event-name=Menu plausible-event-pozycja=Specjalizacje"
          data-nav="specjalizacje"
          aria-current={if assigns[:active_nav] == "specjalizacje", do: "page"}
          aria-haspopup="true"
          href={~p"/#specjalizacje"}
        >
          Specjalizacje
        </a>
        <div class="invisible absolute top-full left-1/2 z-20 w-[min(760px,90vw)] -translate-x-1/2 translate-y-1 pt-4 opacity-0 transition duration-200 group-focus-within/spec:visible group-focus-within/spec:translate-y-0 group-focus-within/spec:opacity-100 group-hover/spec:visible group-hover/spec:translate-y-0 group-hover/spec:opacity-100 max-xl:hidden motion-reduce:transition-none">
          <div class="grid grid-cols-2 gap-8 rounded-[14px] border border-line-soft bg-white p-6 whitespace-normal shadow-[0_24px_50px_-28px_rgba(47,71,102,.45)]">
            <div :for={
              {label, audience} <- [
                {"Dla osób prywatnych", :private},
                {"Dla przedsiębiorców", :business}
              ]
            }>
              <p class="m-0 mb-2 text-[.75rem] font-semibold tracking-[.14em] text-brass-deep uppercase">
                {label}
              </p>
              <ul class="grid gap-[.15rem]">
                <li :for={service <- KralukKurkierewicz.Services.home(audience)}>
                  <a
                    class="block rounded-md px-2 py-[.35rem] text-[.9rem] leading-snug text-copy transition-colors hover:bg-paper hover:text-ink"
                    href={~p"/uslugi/#{service.slug}"}
                  >
                    {service.name}
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <a
        class="border-b border-transparent py-1 hover:border-brass max-xl:border-line-soft max-xl:py-3 plausible-event-name=Menu plausible-event-pozycja=Jak+pracujemy"
        data-nav="jak-pracujemy"
        href={~p"/#jak-pracujemy"}
      >
        Jak pracujemy
      </a>
      <a
        class="border-b border-transparent py-1 hover:border-brass max-xl:border-line-soft max-xl:py-3 plausible-event-name=Menu plausible-event-pozycja=O+kancelarii"
        data-nav="o-nas"
        href={~p"/#o-nas"}
      >
        O kancelarii
      </a>
      <a
        class="border-b border-transparent py-1 hover:border-brass max-xl:border-line-soft max-xl:py-3 plausible-event-name=Menu plausible-event-pozycja=Zespol"
        data-nav="zespol"
        href={~p"/#zespol"}
      >
        Zespół
      </a>
      <a
        class="border-b border-transparent py-1 hover:border-brass max-xl:border-line-soft max-xl:py-3 plausible-event-name=Menu plausible-event-pozycja=Blog"
        data-nav="blog"
        aria-current={if assigns[:active_nav] == "blog", do: "page"}
        href={~p"/blog"}
      >
        Blog
      </a>
      <a
        class="btn border-b-transparent px-[1.1rem] py-[.6rem] text-[.9rem] max-xl:mt-4 max-xl:text-center plausible-event-name=CTA plausible-event-cel=Umow-spotkanie"
        href={~p"/#kontakt"}
      >
        Umów spotkanie
      </a>
    </nav>
    <button
      aria-expanded="false"
      aria-label="Menu"
      class="block cursor-pointer border-0 bg-transparent text-[1.6rem] leading-normal text-ink xl:hidden"
      id="nav-toggle"
    >
      ☰
    </button>
  </div>
</header>
